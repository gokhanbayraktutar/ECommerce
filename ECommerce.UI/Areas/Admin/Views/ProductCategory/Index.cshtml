@model List<ECommerce.Core.Entities.ProductCategory>

@{
    ViewData["Title"] = "Ürün-Kategori İlişkileri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int rowCount = 1;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="card-title">Eşleşen Ürün ve Kategoriler</h4>
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createModal">
                        <i class="mdi mdi-plus me-1"></i> Yeni Ürün-Kategori Ekle
                    </button>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                <table class="table table-bordered dt-responsive nowrap w-100">
                    <thead>
                        <tr>
                            <th>Sıra No</th>
                            <th>Ürün Adı</th>
                            <th>Kategori Adı</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@(rowCount++)</td>
                                    <td>@(item.Product?.Name ?? "Bulunamadı")</td>
                                    <td>@(item.Category?.Name ?? "Bulunamadı")</td>
                                    <td class="text-center">
                                        <form asp-action="Delete"
                                              asp-route-productId="@item.ProductId"
                                              asp-route-categoryId="@item.CategoryId"
                                              method="post"
                                              onsubmit="return confirm('Bu ilişkiyi silmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">Kayıtlı ilişki bulunamadı.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Yeni İlişki Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Ürün</label>
                        <select name="ProductId" class="form-select" asp-items="ViewBag.Products" required>
                            <option value="">Seçiniz...</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kategori</label>
                        <select name="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                            <option value="">Seçiniz...</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>